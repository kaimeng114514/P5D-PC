{
  "version": 1,
  "purpose": "Golden-semantics cases for the P5D static AOT recompiler (ARMv7 Thumb-2). Each case feeds one or more real/hand-encoded Thumb instructions to the generated C++ translation and compares the resulting register file, memory and APSR against the independent Python reference model in tools/aot_difftest.py. The 'expect' blocks are hand-derived constants that pin the bug classes we have been bitten by; the driver verifies the reference model against them on every run.",
  "encoding_sources": {
    "elf": "C:\\dev\\p5d_build\\p5d_true.elf (instruction bytes taken verbatim; 'src' fields give the ELF VA)",
    "hand": "hand-encoded ARMv7-M/Thumb-2, verified with capstone; used for edge encodings absent from the ELF (e.g. shift-by-32)"
  },
  "defaults": {
    "va": "0x81000000",
    "apsr": "0x00000000"
  },
  "cases": [
